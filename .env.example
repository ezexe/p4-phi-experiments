# Copy to .env (ignored) and fill in. Loaded by experiments/env.py; a value already in the environment wins.
# Leave ANTHROPIC_API_KEY empty to use `ant auth login` instead.
ANTHROPIC_API_KEY=
# ANTHROPIC_WORKSPACE_ID=

# The p4 store the experiments read: a git URL or a local path of a store repository (one branch per machine).
# keep_or_go and served_back stop without one; --store overrides it.
P4_STORE_REPO=
# The project checkout that store belongs to (its repo: labels name files there); optional.
P4_PROJECT=
# keep_or_go: handwritten skill directories to test against the p4 marketplace, separated by ; on Windows, : elsewhere.
P4_SKILL_DIRS=
